		for id, d in SortedPairs(RPInv.Items) do
			local hay = string.lower(d.name .. " " .. id .. " " .. (d.category or "") .. " " .. (d.use_arg or ""))
			if q == "" or string.find(hay, q, 1, true) then
				T.AddLine(itemList, id, d.name, d.w .. "x" .. d.h, d.use_type, d.max_stack)
			end
