local function readJSON()
	local len = net.ReadUInt(32)
	return util.JSONToTable(util.Decompress(net.ReadData(len)) or "") or {}
end

local function sendJSON(name, tbl)
	local data = util.Compress(util.TableToJSON(tbl))
	net.Start(name)
