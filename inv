	if not IsValid(ent) then return false, "This resource cannot be placed." end
	inst.amount = inst.amount - n + 1
	ply:DoCustomAnimEvent(PLAYERANIMEVENT_CUSTOM_GESTURE, ACT_GMOD_GESTURE_ITEM_PLACE)
