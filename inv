		ply.RPInvRestore = nil
	elseif RPInv.Settings.death_mode == "drop" then
		E.DropAll(ply)
		ply.RPInvArmorPending = nil
		ply.RPInvRestore = nil
	else
		E.SaveArmor(ply)
		E.SaveAmmo(ply)
		ply.RPInvArmorPending = true
		ply.RPInvRestore = "death"
	end
end)

hook.Add("PostPlayerDeath", "RPInv_KeepArmor", function(ply)
