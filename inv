hook.Add("DoPlayerDeath", "RPInv_EquipDeath", function(ply)
	timer.Remove("RPInv_EqSave" .. ply:EntIndex())
	ply.RPInvDeathWeapons = {}
	for _, inst in pairs(state(ply).weapons) do
		local def = weaponDef(inst)
		if def then
