			draw.SimpleText("R: ROTATE   CTRL+DRAG: ONE   SHIFT+CLICK: QUICK MOVE", "RPInv.Tiny", pw - T.S(8), ph - T.S(10), T.Dim, TEXT_ALIGN_RIGHT, TEXT_ALIGN_CENTER)
