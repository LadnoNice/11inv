local T = RPInv.Theme
local A = RPInv.Att

local win
local FOV = 30
local HAND = "ValveBiped.Bip01_R_Hand"
local ORIGIN = Vector(0, 0, 0)
local LINE = Color(235, 235, 228, 110)

