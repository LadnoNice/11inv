local function sizeFor(ent)
	local s = ent:OBBMaxs() - ent:OBBMins()
	local long = math.max(s.x, s.y, s.z)
	if long <= 9 then return 1, 1 end
	if long <= 16 then return 2, 1 end
	if long <= 26 then return 2, 2 end
	return 3, 2
end

