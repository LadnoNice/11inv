	search:SetFont("RPInv.Small")
	search:SetSize(T.S(140), T.S(22))
	search:SetPos(right - sort:GetWide() - T.S(6) - search:GetWide(), y)
	search:SetUpdateOnType(true)
	search.OnValueChange = function(s) grid.Search = s:GetText() end
