	ply.RPInvHoldCmd = true
	local e = ply:GetEyeTrace().Entity
	if IsValid(e) and e.RPInvCorpseId and RPInv.StartLoot and ply:GetShootPos():DistToSqr(ply:GetEyeTrace().HitPos) < 140 * 140 then
